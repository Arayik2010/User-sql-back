# Local development (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simple_app
DB_USER=postgres
DB_PASSWORD=your_password_here

PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
JWT_SECRET=change-me-in-production

# Production: set this on the host (Render, etc.). When present, it overrides DB_* above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
